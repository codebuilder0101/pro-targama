# Copy to .env for local dev. Set the SAME variables in your host (e.g. Vercel)
# as server-side environment variables. Never commit real values.

# OpenAI (translation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase (favorites) — service_role key is server-only, never expose to the client
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
